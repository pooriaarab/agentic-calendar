{
  "name": "agentic-calendar",
  "version": "0.1.1",
  "description": "Google Calendar event adapters and a Cal.com scaffold for Node.js, TypeScript, CLI, and Model Context Protocol calendar tools.",
  "keywords": [
    "google-calendar",
    "cal.com",
    "calendar",
    "events",
    "scheduling",
    "typescript",
    "nodejs",
    "cli",
    "mcp",
    "model-context-protocol",
    "calendar-api",
    "dry-run"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "https://github.com/pooriaarab/agentic-calendar.git"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-calendar",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentic-calendar": "./dist/cli.js",
    "agentic-calendar-mcp": "./dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "agentic-core": "^0.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
